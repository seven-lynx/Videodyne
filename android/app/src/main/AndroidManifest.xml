<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- What both apps need. The TV and the phone builds declare their own activity, launch
         categories and hardware requirements in src/tv/AndroidManifest.xml and
         src/phone/AndroidManifest.xml, because those are exactly where the two differ. -->
    <application
        android:name=".WbtvApp"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Videodyne" />
</manifest>
